# Зависимости — у пакета их нет в рантайме, это защита от случайной установки
node_modules/

# Продукты сборки и упаковки
dist/
*.tgz
.npm-cache/

# Логи
*.log
npm-debug.log*

# Секреты: ключ не должен попасть в репозиторий, как и зеркало каталога
.env
.env.*
!.env.example
.credentials.yaml

# Состояние редактора и ОС
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Черновики
tmp/
.tmp/
coverage/
PUBLISHING.md

# Инструкция агенту для новых чатов: рабочая шпаргалка этой машины.
AGENTS.md

# Рабочий слепок внутренностей harness: распакованный app.asar, которым
# пользуется разработка. Производные данные, в пакет и в историю не входят.
.asar-src/
.tmp-asar-*

# Сервер-коллектор монитора аптайма. Это отдельный разворачиваемый сервис, а не
# часть плагина: он живёт рядом с разработкой для удобства, но в пакет dsh-rustvy
# и в его историю входить не должен. Внутри — свои зависимости, конфиг с адресами
# и данные, накопленные при локальных прогонах.
rustvy-uptime/

# Продукты сборки Go-коллектора: бинарь не должен попасть ни сюда, ни куда-либо ещё
*.exe
rustvy-uptime/rustvy-uptime
