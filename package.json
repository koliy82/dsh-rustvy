{
  "name": "dsh-rustvy",
  "version": "1.1.0",
  "description": "Rustvy for DeepSeek Harness: vendor marks in the model picker, a model list kept in step with what the provider actually serves, and a ring of API keys that lets each chat send its requests with a key of its own — the host half mirrors the catalog and logos to loopback, regenerates the pi-ai route's models from the route's own endpoint with the drift shown before anything is written, and clones that route once per key, so a key value stays in the harness credential store and never in the plugin's files.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "icon": "assets/icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "harness-plugin",
    "rustvy",
    "dsh-rustvy",
    "model-picker",
    "model-icons",
    "model-list",
    "model-sync",
    "api-key",
    "api-keys",
    "key-ring",
    "credentials",
    "llm-pi-ai",
    "vendor-logo",
    "web-gui",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koliy82/dsh-rustvy.git"
  },
  "homepage": "https://github.com/koliy82/dsh-rustvy#readme",
  "bugs": {
    "url": "https://github.com/koliy82/dsh-rustvy/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "lib",
    "client",
    "locale",
    "assets",
    "cordis.patch.yml",
    "install.ps1",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "prepublishOnly": "node scripts/prepublish-check.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
